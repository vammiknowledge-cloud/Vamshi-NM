<style>
:root{--bg:#07090d;--card:#111722;--text:#f5f7fb;--muted:#9ba6b6;--line:#263141;--a:#6ee7ff;--b:#a78bfa;--max:1160px}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:radial-gradient(circle at 10% 0%,#12303a,transparent 30%),radial-gradient(circle at 90% 10%,#241b42,transparent 30%),var(--bg);color:var(--text);line-height:1.6}a{color:inherit;text-decoration:none}.wrap{width:min(92%,var(--max));margin:auto}
nav{position:sticky;top:0;z-index:10;background:#07090ddd;backdrop-filter:blur(15px);border-bottom:1px solid #ffffff12}.nav{min-height:70px;display:flex;align-items:center;justify-content:space-between}.logo{font-size:22px;font-weight:900}.logo span{color:var(--a)}.links{display:flex;gap:24px;color:var(--muted);font-weight:700;font-size:14px}.links a:hover{color:#fff}
.hero{padding:100px 0 75px}.heroGrid{display:grid;grid-template-columns:1.2fr .8fr;gap:55px;align-items:center}.badge{display:inline-block;border:1px solid #334254;background:#0d131c;border-radius:99px;padding:7px 13px;font-size:12px;font-weight:900;color:#cbd5e1;margin-bottom:20px}.dot{display:inline-block;width:7px;height:7px;background:#61e7a3;border-radius:50%;margin-right:7px}
h1{font-size:clamp(52px,8vw,88px);line-height:.95;letter-spacing:-.065em;margin-bottom:22px}.grad{background:linear-gradient(100deg,#fff,var(--a),var(--b));color:transparent;background-clip:text}.lead{font-size:19px;color:var(--muted);max-width:720px}.buttons{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{padding:12px 18px;border:1px solid var(--line);border-radius:12px;font-weight:800;font-size:14px}.primary{background:#fff;color:#080a0e;border-color:#fff}
.profile{background:linear-gradient(145deg,#17202d,#0c1118);border:1px solid var(--line);padding:14px;border-radius:25px}.photo{aspect-ratio:1;border-radius:18px;background:#0b1118;display:flex;align-items:center;justify-content:center;text-align:center;color:#7e8a9b;overflow:hidden}.photo img{width:100%;height:100%;object-fit:cover}.pinfo{padding:17px 7px 5px}.pinfo b{font-size:20px}.pinfo p{font-size:13px;color:var(--muted)}
section{padding:78px 0;border-top:1px solid #ffffff09}.kicker{color:var(--a);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase;margin-bottom:9px}.title{font-size:clamp(32px,5vw,50px);line-height:1.05;letter-spacing:-.045em;margin-bottom:13px}.intro{color:var(--muted);max-width:750px;margin-bottom:32px}
.grid2{display:grid;grid-template-columns:.8fr 1.2fr;gap:18px}.card{background:linear-gradient(145deg,var(--card),#0c1118);border:1px solid var(--line);border-radius:20px;padding:25px}.card h3{font-size:21px;margin-bottom:8px}.card p,.role p{color:var(--muted)}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.stat{border:1px solid var(--line);border-radius:14px;padding:15px;background:#0c1118}.stat b{font-size:25px;display:block}.stat span{font-size:11px;color:var(--muted)}
.roles{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.role{border:1px solid var(--line);border-radius:17px;padding:21px;background:#101722}.role h3{margin-bottom:6px}.timeline{display:grid;gap:0}.item{display:grid;grid-template-columns:150px 1fr;gap:20px;padding:19px 0;border-bottom:1px solid var(--line)}.item:last-child{border:0}.year{color:var(--a);font-weight:900;font-size:12px}
.tools{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:20px}.upload{display:inline-block;padding:12px 16px;border:1px dashed #536276;border-radius:12px;font-weight:800;cursor:pointer}.upload input{display:none}.hint{font-size:12px;color:var(--muted)}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.gallery .photo{aspect-ratio:4/3;border:1px solid var(--line);position:relative}.label{position:absolute;left:9px;bottom:9px;background:#000b;padding:4px 8px;border-radius:7px;font-size:11px}
.contact{display:grid;grid-template-columns:1fr 1fr;gap:15px}.contact a{color:var(--a);font-weight:800;word-break:break-word}footer{border-top:1px solid var(--line);padding:35px 0;color:#7e8999;font-size:13px}
@media(max-width:800px){.heroGrid,.grid2,.contact{grid-template-columns:1fr}.links{display:none}.roles{grid-template-columns:1fr}.gallery{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.gallery,.stats{grid-template-columns:1fr}h1{font-size:55px}.item{grid-template-columns:1fr;gap:3px}}
</style>
</head>
<body>
